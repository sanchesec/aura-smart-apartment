<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_GestaoAdmin" targetNamespace="http://aura-smart-apartment.local/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:process id="Process_GestaoAdmin" name="Gestão Administrativa de Solicitações e Prestadores" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_GestaoAdmin">
      <bpmn:lane id="Lane_Admin" name="PORTARIA / ADMIN">
        <bpmn:flowNodeRef>A_Encerrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Analisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Cadastrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Selecionar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Acompanhar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Atribuir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Concluido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_PrestadorExiste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Final</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="A_Start" name="Nova solicitação recebida" />
    <bpmn:task id="A_Analisar" name="Analisar solicitação" />
    <bpmn:exclusiveGateway id="A_PrestadorExiste" name="Há prestador adequado disponível?" />
    <bpmn:task id="A_Cadastrar" name="Cadastrar ou ativar prestador" />
    <bpmn:task id="A_Selecionar" name="Selecionar prestador">
      <bpmn:incoming>Flow_1mfi0nl</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="A_Atribuir" name="Atribuir serviço">
      <bpmn:incoming>AF10</bpmn:incoming>
      <bpmn:outgoing>Flow_1mfi0nl</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_Acompanhar" name="Acompanhar status" />
    <bpmn:exclusiveGateway id="A_Concluido" name="Serviço concluído?" />
    <bpmn:task id="A_Revisar" name="Revisar pendência / reatribuir" />
    <bpmn:task id="A_Encerrar" name="Registrar conclusão" />
    <bpmn:endEvent id="A_Final" name="Gestão da solicitação encerrada" />
    <bpmn:sequenceFlow id="AF1" sourceRef="A_Start" targetRef="A_Analisar" />
    <bpmn:sequenceFlow id="AF2" sourceRef="A_Analisar" targetRef="A_PrestadorExiste" />
    <bpmn:sequenceFlow id="AF3" name="Não" sourceRef="A_PrestadorExiste" targetRef="A_Cadastrar" />
    <bpmn:sequenceFlow id="AF4" sourceRef="A_Cadastrar" targetRef="A_Selecionar" />
    <bpmn:sequenceFlow id="AF5" name="Sim" sourceRef="A_PrestadorExiste" targetRef="A_Selecionar" />
    <bpmn:sequenceFlow id="AF6" sourceRef="A_Selecionar" targetRef="A_Atribuir" />
    <bpmn:sequenceFlow id="AF7" sourceRef="A_Atribuir" targetRef="A_Acompanhar" />
    <bpmn:sequenceFlow id="AF8" sourceRef="A_Acompanhar" targetRef="A_Concluido" />
    <bpmn:sequenceFlow id="AF9" name="Não" sourceRef="A_Concluido" targetRef="A_Revisar" />
    <bpmn:sequenceFlow id="AF10" sourceRef="A_Revisar" targetRef="A_Atribuir" />
    <bpmn:sequenceFlow id="AF11" name="Sim" sourceRef="A_Concluido" targetRef="A_Encerrar" />
    <bpmn:sequenceFlow id="AF12" sourceRef="A_Encerrar" targetRef="A_Final" />
    <bpmn:sequenceFlow id="Flow_1mfi0nl" sourceRef="A_Atribuir" targetRef="A_Selecionar" />
  </bpmn:process>
