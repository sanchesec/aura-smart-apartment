<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_SolicitacaoServico" targetNamespace="http://aura-smart-apartment.local/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:process id="Process_SolicitacaoServico" name="Solicitação de Manutenção, Reparo ou Limpeza" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_SolicitacaoServico">
      <bpmn:lane id="Lane_Prestador" name="PRESTADOR">
        <bpmn:flowNodeRef>S_Receber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Executar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Foto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Concluir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Iniciar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Aceita</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="PORTARIA / ADMIN">
        <bpmn:flowNodeRef>S_Analisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Atribuir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Reatribuir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Morador" name="MORADOR">
        <bpmn:flowNodeRef>S_Acompanhar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Criar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Final</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_Start" name="Morador identifica necessidade" />
    <bpmn:task id="S_Criar" name="Criar solicitação + foto opcional" />
    <bpmn:task id="S_Analisar" name="Analisar" />
    <bpmn:task id="S_Atribuir" name="Atribuir prestador" />
    <bpmn:task id="S_Receber" name="Prestador recebe serviço" />
    <bpmn:exclusiveGateway id="S_Aceita" name="Prestador aceita?" />
    <bpmn:task id="S_Reatribuir" name="Reatribuir prestador" />
    <bpmn:task id="S_Iniciar" name="Iniciar atendimento" />
    <bpmn:task id="S_Executar" name="Executar serviço" />
    <bpmn:task id="S_Foto" name="Adicionar foto de conclusão" />
    <bpmn:task id="S_Concluir" name="Concluir serviço" />
    <bpmn:task id="S_Acompanhar" name="Morador visualiza resultado" />
    <bpmn:endEvent id="S_Final" name="Solicitação CONCLUIDA" />
    <bpmn:sequenceFlow id="SF1" sourceRef="S_Start" targetRef="S_Criar" />
    <bpmn:sequenceFlow id="SF2" sourceRef="S_Criar" targetRef="S_Analisar" />
    <bpmn:sequenceFlow id="SF3" sourceRef="S_Analisar" targetRef="S_Atribuir" />
    <bpmn:sequenceFlow id="SF4" sourceRef="S_Atribuir" targetRef="S_Receber" />
    <bpmn:sequenceFlow id="SF5" sourceRef="S_Receber" targetRef="S_Aceita" />
    <bpmn:sequenceFlow id="SF6" name="Não" sourceRef="S_Aceita" targetRef="S_Reatribuir" />
    <bpmn:sequenceFlow id="SF7" sourceRef="S_Reatribuir" targetRef="S_Atribuir" />
    <bpmn:sequenceFlow id="SF8" name="Sim" sourceRef="S_Aceita" targetRef="S_Iniciar" />
    <bpmn:sequenceFlow id="SF9" sourceRef="S_Iniciar" targetRef="S_Executar" />
    <bpmn:sequenceFlow id="SF10" sourceRef="S_Executar" targetRef="S_Foto" />
    <bpmn:sequenceFlow id="SF11" sourceRef="S_Foto" targetRef="S_Concluir" />
    <bpmn:sequenceFlow id="SF12" sourceRef="S_Concluir" targetRef="S_Acompanhar" />
    <bpmn:sequenceFlow id="SF13" sourceRef="S_Acompanhar" targetRef="S_Final" />
  </bpmn:process>
