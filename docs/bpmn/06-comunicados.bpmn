<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_Comunicados" targetNamespace="http://aura-smart-apartment.local/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:process id="Process_Comunicados" name="Publicação de Comunicados" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Comunicados">
      <bpmn:lane id="Lane_Morador" name="MORADOR">
        <bpmn:flowNodeRef>C_Visualizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Final</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="SISTEMA — BUBBLE">
        <bpmn:flowNodeRef>C_Publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Disponibilizar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="ADMIN / PORTARIA">
        <bpmn:flowNodeRef>C_Criar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Preencher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_Start</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="C_Start" name="Admin identifica necessidade de comunicação" />
    <bpmn:task id="C_Criar" name="Criar comunicado" />
    <bpmn:task id="C_Preencher" name="Informar título, descrição, categoria e anexo" />
    <bpmn:task id="C_Publicar" name="Publicar no Bubble" />
    <bpmn:task id="C_Disponibilizar" name="Disponibilizar aos moradores" />
    <bpmn:task id="C_Visualizar" name="Morador visualiza comunicado" />
    <bpmn:endEvent id="C_Final" name="Comunicado entregue" />
    <bpmn:sequenceFlow id="CF1" sourceRef="C_Start" targetRef="C_Criar" />
    <bpmn:sequenceFlow id="CF2" sourceRef="C_Criar" targetRef="C_Preencher" />
    <bpmn:sequenceFlow id="CF3" sourceRef="C_Preencher" targetRef="C_Publicar" />
    <bpmn:sequenceFlow id="CF4" sourceRef="C_Publicar" targetRef="C_Disponibilizar" />
    <bpmn:sequenceFlow id="CF5" sourceRef="C_Disponibilizar" targetRef="C_Visualizar" />
    <bpmn:sequenceFlow id="CF6" sourceRef="C_Visualizar" targetRef="C_Final" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_Comunicados">
    <bpmndi:BPMNPlane id="Plane_Process_Comunicados" bpmnElement="Process_Comunicados">
