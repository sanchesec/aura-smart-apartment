<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_ControlePortaria" targetNamespace="http://aura-smart-apartment.local/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:process id="Process_ControlePortaria" name="Controle de Acesso pela Portaria" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_ControlePortaria">
      <bpmn:lane id="Lane_Sistema" name="SISTEMA — BUBBLE">
        <bpmn:flowNodeRef>R_Dentro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Finalizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Consultar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Negar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Autorizado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_FimNegado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Final</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Portaria" name="PORTARIA">
        <bpmn:flowNodeRef>R_Conferir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Entrada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Saida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Pesquisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>R_Start</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="R_Start" name="Visitante ou prestador chega" />
    <bpmn:task id="R_Pesquisar" name="Pesquisar por nome, documento ou código" />
    <bpmn:task id="R_Consultar" name="Consultar autorização no Bubble" />
    <bpmn:exclusiveGateway id="R_Autorizado" name="Acesso autorizado?" />
    <bpmn:task id="R_Negar" name="Negar entrada e registrar ocorrência" />
    <bpmn:endEvent id="R_FimNegado" name="Acesso não realizado" />
    <bpmn:task id="R_Conferir" name="Conferir informações" />
    <bpmn:task id="R_Entrada" name="Registrar entrada" />
    <bpmn:task id="R_Dentro" name="Atualizar status para DENTRO" />
    <bpmn:task id="R_Saida" name="Registrar saída" />
    <bpmn:task id="R_Finalizar" name="Atualizar status para FINALIZADA" />
    <bpmn:endEvent id="R_Final" name="Acesso encerrado" />
    <bpmn:sequenceFlow id="RF1" sourceRef="R_Start" targetRef="R_Pesquisar" />
    <bpmn:sequenceFlow id="RF2" sourceRef="R_Pesquisar" targetRef="R_Consultar" />
    <bpmn:sequenceFlow id="RF3" sourceRef="R_Consultar" targetRef="R_Autorizado" />
    <bpmn:sequenceFlow id="RF4" name="Não" sourceRef="R_Autorizado" targetRef="R_Negar" />
    <bpmn:sequenceFlow id="RF5" sourceRef="R_Negar" targetRef="R_FimNegado" />
    <bpmn:sequenceFlow id="RF6" name="Sim" sourceRef="R_Autorizado" targetRef="R_Conferir" />
    <bpmn:sequenceFlow id="RF7" sourceRef="R_Conferir" targetRef="R_Entrada" />
    <bpmn:sequenceFlow id="RF8" sourceRef="R_Entrada" targetRef="R_Dentro" />
    <bpmn:sequenceFlow id="RF9" sourceRef="R_Dentro" targetRef="R_Saida" />
    <bpmn:sequenceFlow id="RF10" sourceRef="R_Saida" targetRef="R_Finalizar" />
    <bpmn:sequenceFlow id="RF11" sourceRef="R_Finalizar" targetRef="R_Final" />
  </bpmn:process>
