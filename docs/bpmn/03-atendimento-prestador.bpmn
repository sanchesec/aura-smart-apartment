<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_AtendimentoPrestador" targetNamespace="http://aura-smart-apartment.local/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:process id="Process_AtendimentoPrestador" name="Atendimento do Prestador" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_AtendimentoPrestador">
      <bpmn:lane id="Lane_Prestador" name="PRESTADOR">
        <bpmn:flowNodeRef>P_Ver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Iniciar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Executar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Foto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Concluir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Aceita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Final</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin" name="PORTARIA / ADMIN">
        <bpmn:flowNodeRef>P_Recusa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P_Reatribui</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P_Start" name="Serviço atribuído ao ao funcionário">
      <bpmn:outgoing>Flow_0k7h3ye</bpmn:outgoing>
      <bpmn:outgoing>Flow_0vydm46</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P_Ver" name="Visualizar detalhes do serviço">
      <bpmn:incoming>Flow_0vydm46</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P_Aceita" name="Aceitar serviço?" />
    <bpmn:task id="P_Recusa" name="Informar recusa" />
    <bpmn:task id="P_Reatribui" name="Administrador reatribui aos funcionários">
      <bpmn:incoming>Flow_0k7h3ye</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="P_Iniciar" name="Iniciar atendimento">
      <bpmn:incoming>PF6</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="P_Executar" name="Executar serviço" />
    <bpmn:task id="P_Foto" name="Adicionar foto final" />
    <bpmn:task id="P_Concluir" name="Marcar como concluído" />
    <bpmn:endEvent id="P_Final" name="Atendimento concluído" />
    <bpmn:sequenceFlow id="PF2" sourceRef="P_Ver" targetRef="P_Aceita" />
    <bpmn:sequenceFlow id="PF3" name="Não" sourceRef="P_Aceita" targetRef="P_Recusa" />
    <bpmn:sequenceFlow id="PF4" sourceRef="P_Recusa" targetRef="P_Reatribui" />
    <bpmn:sequenceFlow id="PF6" name="Sim" sourceRef="P_Aceita" targetRef="P_Iniciar" />
    <bpmn:sequenceFlow id="PF9" sourceRef="P_Iniciar" targetRef="P_Executar" />
    <bpmn:sequenceFlow id="PF10" sourceRef="P_Executar" targetRef="P_Foto" />
    <bpmn:sequenceFlow id="PF11" sourceRef="P_Foto" targetRef="P_Concluir" />
    <bpmn:sequenceFlow id="PF12" sourceRef="P_Concluir" targetRef="P_Final" />
    <bpmn:sequenceFlow id="Flow_0k7h3ye" sourceRef="P_Start" targetRef="P_Reatribui" />
    <bpmn:sequenceFlow id="Flow_0vydm46" sourceRef="P_Start" targetRef="P_Ver" />
  </bpmn:process>
