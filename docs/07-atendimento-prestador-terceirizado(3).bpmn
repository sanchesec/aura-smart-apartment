<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    id="Definitions_PrestadorTerceirizado"
    targetNamespace="http://aura-smart-apartment.local/bpmn">

  <bpmn:process id="Process_PrestadorTerceirizado"
                name="Atendimento de Prestador Terceirizado"
                isExecutable="false">

    <bpmn:laneSet id="LaneSet_PrestadorTerceirizado">

      <bpmn:lane id="Lane_AdminPortaria" name="PORTARIA / ADMIN">
        <bpmn:flowNodeRef>T_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Selecionar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Reatribuir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ValidarAcesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Entrada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Saida</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Sistema" name="SISTEMA — BUBBLE">
        <bpmn:flowNodeRef>T_Enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_GerarAcesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AtualizarConcluida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Final</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Terceirizado" name="PRESTADOR TERCEIRIZADO">
        <bpmn:flowNodeRef>T_Receber</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Aceita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Recusar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_VerAcesso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Iniciar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Executar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Foto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Concluir</bpmn:flowNodeRef>
      </bpmn:lane>

    </bpmn:laneSet>

    <bpmn:startEvent id="T_Start" name="Solicitação exige prestador terceirizado" />
    <bpmn:task id="T_Selecionar" name="Selecionar ou cadastrar prestador terceirizado" />
    <bpmn:task id="T_Enviar" name="Enviar serviço e especificações ao prestador" />
    <bpmn:task id="T_Receber" name="Visualizar serviço, local, horário e especificações" />
    <bpmn:exclusiveGateway id="T_Aceita" name="Aceita o serviço?" />
    <bpmn:task id="T_Recusar" name="Informar recusa" />
    <bpmn:task id="T_Reatribuir" name="Selecionar outro prestador terceirizado" />
    <bpmn:task id="T_GerarAcesso" name="Gerar autorização / código temporário de acesso" />
    <bpmn:task id="T_VerAcesso" name="Visualizar autorização e código de acesso" />
    <bpmn:task id="T_ValidarAcesso" name="Validar prestador e autorização na entrada" />
    <bpmn:task id="T_Entrada" name="Registrar entrada no condomínio" />
    <bpmn:task id="T_Iniciar" name="Iniciar atendimento" />
    <bpmn:task id="T_Executar" name="Executar serviço" />
    <bpmn:task id="T_Foto" name="Adicionar foto de conclusão" />
    <bpmn:task id="T_Concluir" name="Marcar serviço como concluído" />
    <bpmn:task id="T_Saida" name="Registrar saída do condomínio" />
    <bpmn:task id="T_AtualizarConcluida" name="Atualizar solicitação para CONCLUIDA" />
    <bpmn:endEvent id="T_Final" name="Atendimento terceirizado encerrado" />

    <bpmn:sequenceFlow id="TF1" sourceRef="T_Start" targetRef="T_Selecionar" />
    <bpmn:sequenceFlow id="TF2" sourceRef="T_Selecionar" targetRef="T_Enviar" />
    <bpmn:sequenceFlow id="TF3" sourceRef="T_Enviar" targetRef="T_Receber" />
    <bpmn:sequenceFlow id="TF4" sourceRef="T_Receber" targetRef="T_Aceita" />

    <bpmn:sequenceFlow id="TF5" name="Não" sourceRef="T_Aceita" targetRef="T_Recusar" />
    <bpmn:sequenceFlow id="TF6" sourceRef="T_Recusar" targetRef="T_Reatribuir" />
    <bpmn:sequenceFlow id="TF7" sourceRef="T_Reatribuir" targetRef="T_Enviar" />

    <bpmn:sequenceFlow id="TF8" name="Sim" sourceRef="T_Aceita" targetRef="T_GerarAcesso" />
    <bpmn:sequenceFlow id="TF9" sourceRef="T_GerarAcesso" targetRef="T_VerAcesso" />
    <bpmn:sequenceFlow id="TF10" sourceRef="T_VerAcesso" targetRef="T_ValidarAcesso" />
    <bpmn:sequenceFlow id="TF11" sourceRef="T_ValidarAcesso" targetRef="T_Entrada" />
    <bpmn:sequenceFlow id="TF12" sourceRef="T_Entrada" targetRef="T_Iniciar" />
    <bpmn:sequenceFlow id="TF13" sourceRef="T_Iniciar" targetRef="T_Executar" />
    <bpmn:sequenceFlow id="TF14" sourceRef="T_Executar" targetRef="T_Foto" />
    <bpmn:sequenceFlow id="TF15" sourceRef="T_Foto" targetRef="T_Concluir" />
    <bpmn:sequenceFlow id="TF16" sourceRef="T_Concluir" targetRef="T_Saida" />
    <bpmn:sequenceFlow id="TF17" sourceRef="T_Saida" targetRef="T_AtualizarConcluida" />
    <bpmn:sequenceFlow id="TF18" sourceRef="T_AtualizarConcluida" targetRef="T_Final" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_PrestadorTerceirizado">
    <bpmndi:BPMNPlane id="Plane_PrestadorTerceirizado"
                     bpmnElement="Process_PrestadorTerceirizado">

      <bpmndi:BPMNShape id="Shape_Lane_AdminPortaria"
                       bpmnElement="Lane_AdminPortaria"
                       isHorizontal="true">
        <dc:Bounds x="100" y="80" width="3300" height="220"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_Sistema"
                       bpmnElement="Lane_Sistema"
                       isHorizontal="true">
        <dc:Bounds x="100" y="300" width="3300" height="220"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Lane_Terceirizado"
                       bpmnElement="Lane_Terceirizado"
                       isHorizontal="true">
        <dc:Bounds x="100" y="520" width="3300" height="220"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_T_Start" bpmnElement="T_Start">
        <dc:Bounds x="160" y="150" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_Selecionar" bpmnElement="T_Selecionar">
        <dc:Bounds x="240" y="125" width="200" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_T_Enviar" bpmnElement="T_Enviar">
        <dc:Bounds x="500" y="345" width="200" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_T_Receber" bpmnElement="T_Receber">
        <dc:Bounds x="760" y="565" width="210" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_Aceita"
                       bpmnElement="T_Aceita"
                       isMarkerVisible="true">
        <dc:Bounds x="1030" y="580" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_Recusar" bpmnElement="T_Recusar">
        <dc:Bounds x="1140" y="565" width="150" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_T_Reatribuir" bpmnElement="T_Reatribuir">
        <dc:Bounds x="1140" y="125" width="200" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_T_GerarAcesso" bpmnElement="T_GerarAcesso">
        <dc:Bounds x="1370" y="345" width="210" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_VerAcesso" bpmnElement="T_VerAcesso">
        <dc:Bounds x="1640" y="565" width="200" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_T_ValidarAcesso" bpmnElement="T_ValidarAcesso">
        <dc:Bounds x="1900" y="125" width="210" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_Entrada" bpmnElement="T_Entrada">
        <dc:Bounds x="2160" y="125" width="180" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_T_Iniciar" bpmnElement="T_Iniciar">
        <dc:Bounds x="2400" y="565" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_Executar" bpmnElement="T_Executar">
        <dc:Bounds x="2610" y="565" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_Foto" bpmnElement="T_Foto">
        <dc:Bounds x="2820" y="565" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_Concluir" bpmnElement="T_Concluir">
        <dc:Bounds x="3040" y="565" width="170" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="S_T_Saida" bpmnElement="T_Saida">
        <dc:Bounds x="2400" y="125" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_AtualizarConcluida"
                       bpmnElement="T_AtualizarConcluida">
        <dc:Bounds x="2640" y="345" width="200" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_T_Final" bpmnElement="T_Final">
        <dc:Bounds x="2910" y="367" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNEdge id="E_TF1" bpmnElement="TF1">
        <di:waypoint x="196" y="168"/><di:waypoint x="240" y="165"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF2" bpmnElement="TF2">
        <di:waypoint x="440" y="165"/><di:waypoint x="470" y="165"/>
        <di:waypoint x="470" y="385"/><di:waypoint x="500" y="385"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF3" bpmnElement="TF3">
        <di:waypoint x="700" y="385"/><di:waypoint x="730" y="385"/>
        <di:waypoint x="730" y="605"/><di:waypoint x="760" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF4" bpmnElement="TF4">
        <di:waypoint x="970" y="605"/><di:waypoint x="1030" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF5" bpmnElement="TF5">
        <di:waypoint x="1080" y="605"/><di:waypoint x="1140" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF6" bpmnElement="TF6">
        <di:waypoint x="1215" y="565"/><di:waypoint x="1215" y="205"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF7" bpmnElement="TF7">
        <di:waypoint x="1140" y="165"/><di:waypoint x="1040" y="165"/>
        <di:waypoint x="1040" y="385"/><di:waypoint x="700" y="385"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF8" bpmnElement="TF8">
        <di:waypoint x="1055" y="580"/><di:waypoint x="1055" y="385"/>
        <di:waypoint x="1370" y="385"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF9" bpmnElement="TF9">
        <di:waypoint x="1580" y="385"/><di:waypoint x="1610" y="385"/>
        <di:waypoint x="1610" y="605"/><di:waypoint x="1640" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF10" bpmnElement="TF10">
        <di:waypoint x="1840" y="605"/><di:waypoint x="1870" y="605"/>
        <di:waypoint x="1870" y="165"/><di:waypoint x="1900" y="165"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF11" bpmnElement="TF11">
        <di:waypoint x="2110" y="165"/><di:waypoint x="2160" y="165"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF12" bpmnElement="TF12">
        <di:waypoint x="2340" y="165"/><di:waypoint x="2370" y="165"/>
        <di:waypoint x="2370" y="605"/><di:waypoint x="2400" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF13" bpmnElement="TF13">
        <di:waypoint x="2560" y="605"/><di:waypoint x="2610" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF14" bpmnElement="TF14">
        <di:waypoint x="2770" y="605"/><di:waypoint x="2820" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF15" bpmnElement="TF15">
        <di:waypoint x="2990" y="605"/><di:waypoint x="3040" y="605"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF16" bpmnElement="TF16">
        <di:waypoint x="3125" y="565"/><di:waypoint x="3125" y="250"/>
        <di:waypoint x="2490" y="250"/><di:waypoint x="2490" y="205"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF17" bpmnElement="TF17">
        <di:waypoint x="2580" y="165"/><di:waypoint x="2610" y="165"/>
        <di:waypoint x="2610" y="385"/><di:waypoint x="2640" y="385"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_TF18" bpmnElement="TF18">
        <di:waypoint x="2840" y="385"/><di:waypoint x="2910" y="385"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
