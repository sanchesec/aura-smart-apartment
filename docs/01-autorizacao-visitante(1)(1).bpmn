<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Process_AutorizacaoVisitante" targetNamespace="http://aura-smart-apartment.local/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:process id="Process_AutorizacaoVisitante" name="Autorização de Visitante" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_AutorizacaoVisitante">
      <bpmn:lane id="Lane_Portaria" name="PORTARIA / ADMIN">
        <bpmn:flowNodeRef>V_Visualizar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_Conferir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_Entrada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_Saida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_Final</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Sistema" name="SISTEMA — BUBBLE / MAKE / PYTHON">
        <bpmn:flowNodeRef>V_Completar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_Motivo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_Valido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Morador" name="MORADOR">
        <bpmn:flowNodeRef>V_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_Invalida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>V_Preencher</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="V_Start" name="Morador deseja autorizar visitante" />
    <bpmn:task id="V_Preencher" name="Preencher dados do visitante" />
    <bpmn:task id="V_Completar" name="Bubble adiciona dados do morador" />
    <bpmn:task id="V_Validar" name="Make envia para API Python" />
    <bpmn:exclusiveGateway id="V_Valido" name="Solicitação válida?" />
    <bpmn:task id="V_Motivo" name="Exibir motivo da invalidação" />
    <bpmn:endEvent id="V_Invalida" name="Solicitação INVALIDA" />
    <bpmn:task id="V_Visualizar" name="Portaria visualiza autorização" />
    <bpmn:task id="V_Conferir" name="Conferir documento ou código" />
    <bpmn:task id="V_Entrada" name="Registrar entrada — DENTRO" />
    <bpmn:task id="V_Saida" name="Registrar saída" />
    <bpmn:endEvent id="V_Final" name="Visita FINALIZADA" />
    <bpmn:sequenceFlow id="VF1" sourceRef="V_Start" targetRef="V_Preencher" />
    <bpmn:sequenceFlow id="VF2" sourceRef="V_Preencher" targetRef="V_Completar" />
    <bpmn:sequenceFlow id="VF3" sourceRef="V_Completar" targetRef="V_Validar" />
    <bpmn:sequenceFlow id="VF4" sourceRef="V_Validar" targetRef="V_Valido" />
    <bpmn:sequenceFlow id="VF5" name="Não" sourceRef="V_Valido" targetRef="V_Motivo" />
    <bpmn:sequenceFlow id="VF6" sourceRef="V_Motivo" targetRef="V_Invalida" />
    <bpmn:sequenceFlow id="VF7" name="Sim — APROVADA" sourceRef="V_Valido" targetRef="V_Visualizar" />
    <bpmn:sequenceFlow id="VF8" sourceRef="V_Visualizar" targetRef="V_Conferir" />
    <bpmn:sequenceFlow id="VF9" sourceRef="V_Conferir" targetRef="V_Entrada" />
    <bpmn:sequenceFlow id="VF10" sourceRef="V_Entrada" targetRef="V_Saida" />
    <bpmn:sequenceFlow id="VF11" sourceRef="V_Saida" targetRef="V_Final" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_AutorizacaoVisitante">
    <bpmndi:BPMNPlane id="Plane_Process_AutorizacaoVisitante" bpmnElement="Process_AutorizacaoVisitante">
